# --- App security ---
DEBUG=false
HOST=127.0.0.1
# Login/authentication for the local application. Change these before any shared or production deployment.
AUTH_SECRET_KEY=local-only-change-this-cyber-range-secret-before-deploying
AUTH_TOKEN_TTL_MINUTES=480
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000123
# Optional legacy development-header auth is disabled by default.
DEV_AUTH_ENABLED=false
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
KEYCLOAK_JWT_AUDIENCE=cyberrange-web
ATTACK_EXECUTION_MODE=simulation
ALLOW_SIMULATED_SANDBOX=true

# --- PostgreSQL ---
POSTGRES_USER=cyberrange
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=cyberrange

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev_only_change_me
KEYCLOAK_DB_PASSWORD=dev_only_change_me

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=dev_only_change_me

# --- Anthropic Copilot (optional) ---
# Leave the placeholder to use the deterministic local demo fallback.
ANTHROPIC_API_KEY=dev_placeholder
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_VERSION=2026-10-21

# --- OpenSearch heap ---
OPENSEARCH_HEAP=1g

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OPENSEARCH_HOST=http://localhost:9200
KEYCLOAK_URL=http://localhost:8080
MINIO_ENDPOINT=localhost:9000

# Provider mode is selected from ANTHROPIC_API_KEY availability; placeholder keys use the deterministic fallback.
LLM_PROVIDER=anthropic_with_local_demo_fallback
